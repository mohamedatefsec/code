# Postgres connection string (Neon/Supabase/local) - use in production/dev
DATABASE_URL="postgresql://user:password@host:5432/codeai?sslmode=require"

# Random long secret used to sign JWT auth tokens. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# مفتاح Google Gemini API لميزة "توليد الأسئلة بالذكاء الاصطناعي" (Phase 8).
# اخترنا Gemini تحديدًا لأنه يوفّر مستوى مجاني دائم بدون بطاقة بنكية.
# احصل عليه من https://aistudio.google.com/apikey
# اختياري: لو تركته فارغًا، صفحة /admin/ai-generator تعمل لكن التوليد يفشل برسالة واضحة.
GEMINI_API_KEY=""

# توكن Vercel Blob لرفع الصور (صورة المدرّس، إلخ). على Vercel، يُضاف
# تلقائيًا بمجرد ربط Blob Store بالمشروع من Storage → Create Database → Blob.
# محليًا: vercel env pull .env.local بعد الربط، أو أنشئ Store مستقل واحصل
# على التوكن من لوحة تحكم Vercel.
BLOB_READ_WRITE_TOKEN=""
